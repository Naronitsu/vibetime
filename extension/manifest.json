{
  "manifest_version": 3,
  "name": "VibeTime for BambooHR",
  "version": "1.1.1",
  "description": "Reads the BambooHR timesheet and clock you are looking at and sends them to VibeTime: when you click the button, and when you punch in or out. Runs only on BambooHR and VibeTime pages; nothing is sent anywhere else.",
  "browser_specific_settings": {
    "gecko": {
      "id": "vibetime-bamboohr@naronitsu.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bamboohr.com/*",
        "https://*.bamboohr.co.uk/*"
      ],
      "js": [
        "parse.js",
        "clock.js",
        "bamboo-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://naronitsu.github.io/vibetime/*"
      ],
      "js": [
        "vibetime-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://naronitsu.github.io/vibetime/*"
  ]
}
